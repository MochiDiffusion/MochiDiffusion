    }, {
      "kind": "group",
      "path": "<PROJECT>/scripts",
      "children": [
        { "path": "build_iris_lib.sh" },
        { "path": "set_build_version.sh" },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/Metal.framework" },
        { "path": "<SDK>/System/Library/Frameworks/MetalPerformanceShaders.framework", "target-membership": [ "Mochi Diffusion/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/MetalPerformanceShadersGraph.framework", "target-membership": [ "Mochi Diffusion/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Mochi Diffusion.app", "id": "036BFC1E294B9F7500D8AD04", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Mochi DiffusionTests.xctest", "id": "AA0000000000000000000002", "type": "wrapper.cfbundle", "index": false },
      ],
    },
