  "targets": [
    {
      "name": "Mochi Diffusion",
      "id": "036BFC1D294B9F7500D8AD04",
      "product": "Products/Mochi Diffusion.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "xcconfig/MochiDiffusion.xcconfig" },
        { "name": "Release", "file": "xcconfig/MochiDiffusion.xcconfig" },
      ],
      "dependencies": [
        "Iris",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "export PATH=\"$PATH:/opt/homebrew/bin\"",
            "if which swift-format > /dev/null; then",
            "  swift-format lint -p -r ./ | sed 's/: error: /: warning: /'",
            "else",
            "  echo \"warning: swift-format not installed, download from https://github.com/apple/swift-format\"",
            "fi",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/scripts/set_build_version.sh",
            "$(TARGET_BUILD_DIR)/$(INFOPLIST_PATH)",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "set -euo pipefail",
            "\"${SRCROOT}/scripts/set_build_version.sh\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "package": "CompactSlider",
          "product-name": "CompactSlider",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "FilterablePicker",
          "product-name": "FilterablePicker",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Musubi",
          "product-name": "Musubi",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ml-stable-diffusion",
          "product-name": "StableDiffusion",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Mochi Diffusion/MochiDiffusion.entitlements",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_ASSET_PATHS": "\"Mochi Diffusion/Preview Content\"",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "HEADER_SEARCH_PATHS": "$(SRCROOT)/iris.c",
        "INFOPLIST_FILE": "MochiDiffusionInfo.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Mochi Diffusion",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.graphics-design",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Graham Bing (2024-)\nJoshua Park (2022-2024)",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "15.6",
        "MARKETING_VERSION": "6.3",
        "OTHER_LDFLAGS": "$(BUILD_DIR)/vendor/iris/$(CONFIGURATION)/libiris_mps.a",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OBJC_BRIDGING_HEADER": "$(SRCROOT)/Mochi Diffusion/Iris-BridgingHeader.h",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "USER_HEADER_SEARCH_PATHS": "$(SRCROOT)/iris.c",
      },
    }, {
      "name": "Mochi DiffusionTests",
      "id": "AA0000000000000000000001",
      "product": "Products/Mochi DiffusionTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Mochi Diffusion",
      "specialized-configurations": [
        { "name": "Debug", "file": "xcconfig/MochiDiffusion.xcconfig" },
        { "name": "Release", "file": "xcconfig/MochiDiffusion.xcconfig" },
      ],
      "dependencies": [
        "Mochi Diffusion",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "HEADER_SEARCH_PATHS": "$(SRCROOT)/iris.c",
        "MACOSX_DEPLOYMENT_TARGET": "15.6",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.joshua-park.Mochi-Diffusion.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_OBJC_BRIDGING_HEADER": "$(SRCROOT)/Mochi Diffusion/Iris-BridgingHeader.h",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Mochi Diffusion.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Mochi Diffusion",
        "USER_HEADER_SEARCH_PATHS": "$(SRCROOT)/iris.c",
      },
    }, {
      "name": "Iris",
      "id": "BFE66B0F2F2ED14800A8965C",
      "kind": "aggregate",
      "build-phases": [
        {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/scripts/build_iris_lib.sh",
